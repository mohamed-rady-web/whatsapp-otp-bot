{
  "name": "whatsapp-otp-bot",
  "version": "1.0.0",
  "description": "Production-ready WhatsApp OTP bot with Selenium automation, API endpoints, and web dashboard",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "docker:build": "docker build -t whatsapp-otp-bot .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "selenium-webdriver": "^4.15.0",
    "sqlite3": "^5.1.6",
    "winston": "^3.11.0",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "qrcode": "^1.5.3",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.1",
    "chromedriver": "^119.0.1",
    "node-cron": "^3.0.3",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.53.0",
    "@types/node": "^20.8.10"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamed-rady-web/whatsapp-otp-bot.git"
  },
  "keywords": [
    "whatsapp",
