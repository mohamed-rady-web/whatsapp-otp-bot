# Environment variables for Docker Compose
# Copy this file to .env and update the values

# Security
API_KEY_SECRET=your-super-secret-api-key-here-change-me
JWT_SECRET=your-jwt-secret-here-change-me
ADMIN_TOKEN=your-admin-token-here-change-me

# Database
DB_PATH=/usr/src/app/data/whatsapp-bot.db

# WhatsApp
WHATSAPP_HEADLESS=true
WHATSAPP_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX_REQUESTS=5

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_TEMPLATE="Your OTP is: {otp}. Valid for {expiry} minutes."

# Application URLs (update for production)
BASE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000/dashboard
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SSL/TLS (for production with nginx)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Let's Encrypt (for automatic SSL)
# LETSENCRYPT_EMAIL=your-email@domain.com
# LETSENCRYPT_DOMAIN=your-domain.com