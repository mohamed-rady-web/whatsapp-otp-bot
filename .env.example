# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_PATH=./data/whatsapp-bot.db

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./data/whatsapp-session
WHATSAPP_TIMEOUT=30000
WHATSAPP_HEADLESS=true

# Security
API_KEY_SECRET=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_TEMPLATE="Your OTP is: {otp}. Valid for {expiry} minutes."

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX_REQUESTS=5

# Chrome/Chromium Configuration
CHROME_EXECUTABLE_PATH=
CHROME_USER_DATA_DIR=./data/chrome-data

# Application URLs
BASE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000/dashboard

# Multi-App Support
DEFAULT_APP_NAME=WhatsApp OTP Bot
MAX_APPS_PER_USER=5

# Session Management
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=10

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Development
DEBUG=whatsapp-bot:*